OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_STORY_MODEL=
OPENAI_DEBRIEF_MODEL=
OPENAI_REVIEW_MODEL=

# Auth.js sign-in
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_TRUST_HOST=true
ADMIN_EMAILS=
