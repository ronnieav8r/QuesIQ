OPENAI_QUIRA_API_KEY=
OPENAI_QUIRA_MODEL=gpt-5.4-mini
OPENAI_STUDY_API_KEY=
OPENAI_STUDY_REALTIME_API_KEY=
OPENAI_DPE_API_KEY=
OPENAI_DPE_REALTIME_API_KEY=
