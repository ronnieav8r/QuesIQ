# Postgres app data
DATABASE_URL=

# Direct OpenAI Realtime browser voice
# Keep real secrets in .env.local and server environment variables.
OPENAI_API_KEY=
OPENAI_EVALUATION_MODEL=gpt-5.4-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# Auth.js sign-in
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_TRUST_HOST=true
ADMIN_EMAILS=
PRICING_CHECK_SECRET=
PRICING_REVIEW_MODEL=gpt-5.4-mini

# Magic-link email sign-in through Brevo transactional email
BREVO_API_KEY=
AUTH_EMAIL_FROM=no-reply@quesiq.com
AUTH_EMAIL_FROM_NAME=QuesIQ

# Add storage and Make credentials only when their implementation slice lands.
