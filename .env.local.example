# QuesIQ local development
# Copy to .env.local. Do not use these values in production.

DATABASE_URL=postgres://quesiq_local:quesiq_local_password@127.0.0.1:5433/quesiq_local
AUTH_SECRET=replace-with-a-local-random-secret
AUTH_TRUST_HOST=true
AUTH_URL=http://127.0.0.1:3100
NEXTAUTH_URL=http://127.0.0.1:3100
# Enables local test-login buttons for development only.
DEV_AUTH_BYPASS_ENABLED=true

ADMIN_EMAILS=

OPENAI_INTERVIEW_API_KEY=
OPENAI_INTERVIEW_TEST_TUNNEL_API_KEY=
OPENAI_INTERVIEW_REALTIME_API_KEY=
OPENAI_STUDY_API_KEY=
OPENAI_STUDY_REALTIME_API_KEY=
OPENAI_DPE_API_KEY=
OPENAI_DPE_REALTIME_API_KEY=
OPENAI_EVALUATION_MODEL=gpt-5.4-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

BREVO_API_KEY=
AUTH_EMAIL_FROM=no-reply@quesiq.com
AUTH_EMAIL_FROM_NAME=QuesIQ

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

PRICING_CHECK_SECRET=
PRICING_REVIEW_MODEL=gpt-5.4-mini
QUESIQ_APP_URL=http://127.0.0.1:3100
