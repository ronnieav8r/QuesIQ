  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "user_id" text [not null]
  "quest_key" text [not null]
  "progress" integer [not null, default: `0`]
  "status" text [not null, default: `'open'`]
  "completed_at" timestamp
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]

  Indexes {
    "quest_key" [name: "study_user_quests_quest_idx"]
    ("user_id", "quest_key") [unique, name: "study_user_quests_user_quest_idx"]
  }
}

Table "study_verifications" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "card_id" uuid [not null]
  "verified_by_user_id" text
  "confidence" float4
  "note" text
  "created_at" timestamp [not null, default: `now()`]
  "verification_status" text
  "evidence" jsonb
  "verifier" text
}

Table "study_xp_rules" {
  "key" text [pk, not null]
  "label" text [not null]
  "description" text [not null]
  "event_type" text [not null]
  "condition_type" text [not null]
  "condition_value" integer [not null, default: `0`]
  "group_key" text [not null, default: `'general'`]
  "award_mode" text [not null, default: `'stack'`]
  "xp" integer [not null, default: `0`]
  "display_order" integer [not null, default: `0`]
  "active" boolean [not null, default: `true`]
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]
}

Table "user" {
  "email" text
  "emailVerified" timestamp
  "id" text [pk, not null]
  "image" text
  "name" text

  Indexes {
    "email" [unique, name: "user_email_unique"]
  }
}

Table "user_feedback" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "user_id" text
  "session_id" uuid
  "kind" text [not null]
  "rating" integer
  "message" text
  "screen" text [not null]
  "user_agent" text
  "browser_language" text
  "viewport" text
  "status" text [not null, default: `'new'`]
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]
  "rating_prompt" text
  "screenshot_data_url" text
  "screenshot_mime_type" text
  "screenshot_name" text
  "screenshot_size" integer

  Indexes {
    "created_at" [name: "user_feedback_created_at_idx"]
    "session_id" [name: "user_feedback_session_idx"]
    "status" [name: "user_feedback_status_idx"]
    "user_id" [name: "user_feedback_user_idx"]
  }
}

Table "user_progression" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "user_id" text [not null]
  "total_xp" integer [not null, default: `0`]
  "level" integer [not null, default: `1`]
  "current_level_xp" integer [not null, default: `0`]
  "next_level_xp" integer [not null, default: `300`]
  "streak_days" integer [not null, default: `0`]
  "longest_streak_days" integer [not null, default: `0`]
  "last_practiced_at" timestamp
  "last_practice_date" text
  "completed_reviews" integer [not null, default: `0`]
  "weakest_score_key" text
  "weakest_score_label" text
  "weakest_score_average_tenths" integer
  "latest_next_action" text
  "updated_at" timestamp [not null, default: `now()`]

  Indexes {
    "user_id" [unique, name: "user_progression_user_id_idx"]
  }
}

Table "user_quests" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "user_id" text [not null]
  "quest_key" text [not null]
  "status" text [not null, default: `'open'`]
  "progress" integer [not null, default: `0`]
  "completed_at" timestamp
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]

  Indexes {
    "quest_key" [name: "user_quests_quest_idx"]
    ("user_id", "quest_key") [unique, name: "user_quests_user_quest_idx"]
  }
}

Table "verificationToken" {
  "expires" timestamp [not null]
  "identifier" text [pk, not null]
  "token" text [pk, not null]
}

Table "voice_debriefs" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "user_id" text
  "session_id" uuid [not null]
  "status" text [not null, default: `'completed'`]
  "artifact" jsonb [not null]
  "transcript" jsonb [not null, default: `'[]'`]
  "model" text [not null]
  "voice" text
  "prompt_config_key" text
  "prompt_config_version" integer
  "started_at" timestamp
  "ended_at" timestamp
  "duration_seconds" integer [not null, default: `0`]
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]

  Indexes {
    "created_at" [name: "voice_debriefs_created_at_idx"]
    "session_id" [unique, name: "voice_debriefs_session_idx"]
    "user_id" [name: "voice_debriefs_user_idx"]
  }
}

