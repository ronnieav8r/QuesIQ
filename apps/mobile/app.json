{
  "expo": {
    "name": "QuesIQ Interview",
    "slug": "quesiq-interview",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quesiq-interview",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.quesiq.interview",
      "buildNumber": "2",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "QuesIQ Interview uses your microphone for live interview practice with Que."
      }
    },
    "android": {
      "package": "com.quesiq.interview",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "@config-plugins/react-native-webrtc",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090D12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-audio",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "a2rks-llc",
    "extra": {
      "eas": {
        "projectId": "2b7b5307-d69e-4188-9392-c1e67d7d7b0d"
      }
    }
  }
}
