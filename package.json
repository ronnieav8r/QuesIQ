{
  "name": "quesiq-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev -H 127.0.0.1 -p 3100",
    "dev:mobile": "node scripts/mobile/run-android-local.mjs start",
    "dev:mobile:android": "node scripts/mobile/run-android-local.mjs",
    "mobile:android:emulator": "node scripts/mobile/start-android-emulator.mjs",
    "mobile:android:prepare": "node scripts/mobile/prepare-android-local.mjs",
    "mobile:android:proof-log": "node scripts/mobile/capture-android-proof-log.mjs",
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:local:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-docker-compose.ps1 up -d postgres",
    "db:local:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-docker-compose.ps1 down",
    "db:local:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "guard:admin": "node scripts/guards/check-lane.mjs admin",
    "guard:dpe": "node scripts/guards/check-lane.mjs dpe",
    "guard:interview": "node scripts/guards/check-lane.mjs interview",
    "guard:nclex": "node scripts/guards/check-lane.mjs nclex",
    "guard:quira": "node scripts/guards/check-lane.mjs quira",
    "guard:study": "node scripts/guards/check-lane.mjs study",
    "prompts:export": "node scripts/admin/export-prompts.mjs",
    "preflight:dpe": "node scripts/dpe/mvp-preflight.mjs",
    "readiness:dpe": "node scripts/dpe/mvp-preflight.mjs",
    "readiness:interview": "node scripts/interview/readiness-check.mjs",
    "readiness:mvp": "node scripts/mvp-readiness.mjs",
    "readiness:nclex": "node scripts/nclex/readiness-check.mjs",
    "readiness:study": "node scripts/study/readiness-check.mjs",
    "study:import-canonical": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/study/import-canonical-study-packet.ts",
    "smoke:dpe": "tsx scripts/dpe/answer-smoke.ts",
    "smoke:dpe-concepts": "tsx scripts/dpe/concept-content-smoke.ts",
    "smoke:interview-turns": "tsx scripts/interview/turn-based-smoke.ts",
    "smoke:study": "tsx scripts/study/evaluate-smoke.ts",
    "test:interview:static": "npm run readiness:interview && npm run typecheck && npm run lint",
    "test:interview:services": "tsx scripts/test/interview-services.ts",
    "test:interview:e2e": "node scripts/test/interview-e2e-runner.mjs",
    "test:interview:live-ai": "tsx scripts/test/interview-live-ai.ts",
    "test:interview:all": "npm run test:interview:static && npm run test:interview:services && npm run test:interview:e2e",
    "test:mobile": "npm run test:contracts && npm run test:mobile:api && npm run test --workspace @quesiq/interview-mobile",
    "test:mobile:api": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/test/mobile-auth-services.ts",
    "test:mobile:proof": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/mobile/verify-native-voice-proof.ts",
    "test:contracts": "tsx --test packages/interview-contracts/src/index.test.ts",
    "typecheck:mobile": "npm run typecheck --workspace @quesiq/interview-mobile",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install chromium",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/core": "^0.41.2",
    "@auth/drizzle-adapter": "^1.11.2",
    "@aws-sdk/client-s3": "^3.1056.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "jose": "^6.2.10",
    "next": "^16.2.0",
    "next-auth": "^5.0.0-beta.31",
    "pdf-parse": "^1.1.1",
    "pg": "^8.21.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.15.29",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "overrides": {
    "react-native": "0.86.3"
  }
}
